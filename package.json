{
    "name": "rhr-mcp",
    "version": "1.0.0",
    "private": true,
    "description": "MCP server that gives AI agents structured access to Public Procurement Registry data.",
    "keywords": [
        "mcp",
        "mcp-server",
        "rhr",
        "rhr-mcp"
    ],
    "homepage": "https://github.com/margusliinev/rhr-mcp",
    "license": "MIT",
    "author": "Margus Liinev",
    "repository": {
        "type": "git",
        "url": "https://github.com/margusliinev/rhr-mcp"
    },
    "type": "module",
    "scripts": {
        "dev": "bun --hot src/server.ts",
        "start": "bun src/server.ts",
        "migrate": "bun src/db/migrate.ts",
        "ingest": "bun src/ingest/index.ts",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --fix",
        "lint:check": "oxlint",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "2.0.0",
        "kysely": "0.29.5",
        "kysely-postgres-js": "3.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "typescript": "7.0.2"
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
